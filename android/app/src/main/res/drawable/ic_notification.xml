<?xml version="1.0" encoding="utf-8"?>
<!-- PhotosMove notification small icon: photo frame + two transfer arrows (white, monochrome).
     Content scaled ~1.12 about the center and strokes thickened for legibility at 24dp. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.12"
        android:scaleY="1.12">

        <!-- top arrow: left -> over the top -> right -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.95"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M4.8,13.9 a7.6,7.6 0 0 1 12.6,-7.6" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M16.6,6.6 l3.0,-0.45 -1.1,2.95 z" />

        <!-- bottom arrow: right -> under the bottom -> left -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.95"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M19.2,10.1 a7.6,7.6 0 0 1 -12.6,7.6" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M7.4,17.4 l-3.0,0.45 1.1,-2.95 z" />

        <!-- photo frame -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.85"
            android:fillColor="#00000000"
            android:pathData="M8.3,9.2 h7.4 a1.7,1.7 0 0 1 1.7,1.7 v3.6 a1.7,1.7 0 0 1 -1.7,1.7 h-7.4 a1.7,1.7 0 0 1 -1.7,-1.7 v-3.6 a1.7,1.7 0 0 1 1.7,-1.7 z" />
        <!-- sun -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10.0,11.4 m-0.95,0 a0.95,0.95 0 1 0 1.9,0 a0.95,0.95 0 1 0 -1.9,0" />
        <!-- mountains -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M7.0,15.8 l2.5,-2.6 1.6,1.6 2.1,-2.2 3.0,3.2" />
    </group>
</vector>
