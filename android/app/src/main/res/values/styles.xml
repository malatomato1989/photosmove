<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Card">
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:padding">@dimen/card_padding</item>
    </style>
    <style name="TitleText">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="SubtitleText">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="SectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="PinText">
        <item name="android:textSize">@dimen/text_pin</item>
        <item name="android:textColor">@color/text_pin</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">start</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="UrlText">
        <item name="android:textSize">@dimen/text_url</item>
        <item name="android:textColor">@color/text_url</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textIsSelectable">true</item>
    </style>
    <style name="PrimaryButton">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>
    <style name="CopyButton">
        <item name="android:background">@drawable/btn_copy</item>
        <item name="android:textColor">@color/btn_copy_text</item>
        <item name="android:textSize">@dimen/text_btn</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/spacing_lg</item>
        <item name="android:paddingEnd">@dimen/spacing_lg</item>
    </style>
    <style name="StepText">
        <item name="android:textSize">@dimen/text_step</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
